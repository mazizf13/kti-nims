# 1. File Bobot Model Berukuran Raksasa (> 100 MB - Ditolak GitHub)
# GitHub memiliki batas ketat maksimal 100 MB per file.
*.safetensors
*.bin
*.h5
*.onnx
**/best_indobert_model/model.safetensors
**/best_indobert_model/pytorch_model.bin

# 2. File Bobot PyTorch Lokal (Opsional / Ukuran Besar)
*.pt
*.pth
**/best_bilstm_model.pt

# 3. Arsip & Kompresi Hasil Eksperimen
*.zip
*.tar.gz
*.rar
**/hasil_eksperimen_lengkap.zip
**/hasil_eksperimen_lengkap/

# 4. Folder Lama & Eksperimen Sementara
temp_lexicon/
scratch/
tmp/
temp/

